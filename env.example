# -----------------------------------------------------------------------------
# STANDALONE TOOLS (not in either config file)
# -----------------------------------------------------------------------------

# [FREE TIER] Apify - LinkedIn profile-search actor
# (harvestapi/linkedin-profile-search-by-services). Free monthly platform
# credits, then usage-based billing.
# Used by: employee_discovery.py (Stage A - Apify LinkedIn actor)
APIFY_API_TOKEN=

# [OPTIONAL] Override the Apify actor ID if you swap to a different one.
# Defaults to qXMa8kADnUQdmz18G (harvestapi/linkedin-profile-search-by-services)
# if left unset. Used by: employee_discovery.py
APIFY_ACTOR_ID=

# [FREE, higher limits with a key] Jina AI Reader (r.jina.ai) - fetches a
# text extraction of each maigret hit to verify it's a real profile and
# not a dead/"not found" page before counting it. Works unauthenticated at
# a lower rate limit; add a key here for higher throughput.
# Used by: employee_discovery.py (Stage B verification)
JINA_API_KEY=

# [OPTIONAL] Comma-separated list of maigret site names to check instead of
# the script's default curated list (Instagram,Twitter,Facebook,TikTok,
# LinkedIn,Reddit,YouTube,Pinterest,Snapchat,Telegram,Threads,Discord,VK,
# Tumblr,GitHub). Names must match maigret's own site database exactly.
# Used by: employee_discovery.py (Stage B - maigret)
MAIGRET_SITES=

# [OPTIONAL] Route maigret's own requests through a paid proxy provider to
# help evade per-site rate limits, e.g. socks5://127.0.0.1:1080 or
# http://user:pass@host:port.
# Used by: employee_discovery.py (Stage B - maigret)
MAIGRET_PROXY_URL=

# [OPTIONAL, FREE] Free alternative to the paid proxy above: a local Tor
# SOCKS5 gateway. Now provisioned as the 'tor' service in
# docker-compose.yaml (dperson/torproxy) - maigret runs in its own
# container on the same Compose network, so it reaches Tor via the
# service's DNS name, NOT 127.0.0.1 (that's maigret's own container,
# it has no Tor inside it). If you instead run Tor directly on the host
# (outside Docker), use socks5://127.0.0.1:9050 there instead.
# Used by: employee_discovery.py (Stage B - maigret)
MAIGRET_TOR_PROXY_URL=

# maigret, Amass, Metagoofil, check-if-email-exists: no API key strictly
# required (maigret's optional proxy/site-list overrides are set above).

# [REQUIRED for sfp_ahmia/sfp_torch/sfp_onionsearchengine, and any other
# dark-web-facing module] SpiderFoot's own GLOBAL SOCKS proxy setting -
# separate from MAIGRET_TOR_PROXY_URL above, and NOT set automatically
# just by having the 'tor' service running in docker-compose.yaml.
# Uses the compose service name (or container_name), not 127.0.0.1 -
# SpiderFoot runs in its own container with no Tor inside it.
# CONFIRMED against a live tbl_config dump + the SpiderFoot UI's own
# field description ("SOCKS Server Type. Can be '4', '5', 'HTTP' or
# 'TOR'") - use 'TOR', not '5', or .onion targets fail with a DNS/
# connect-timeout error since plain '5' doesn't get SpiderFoot's
# TOR-specific remote-resolution handling.
# Used by: seed_spiderfoot_db.py (GLOBAL_OPTIONS)
SPIDERFOOT_SOCKS_TYPE=TOR
SPIDERFOOT_SOCKS_HOST=tor
SPIDERFOOT_SOCKS_PORT=9050
SPIDERFOOT_SOCKS_USER=
SPIDERFOOT_SOCKS_PASS=

# [FREE TIER] DeepL Document Translation API - 500,000 free characters/month.
# Free-tier keys are auto-detected by their ":fx" suffix and routed to
# api-free.deepl.com; paid keys (no suffix) go to api.deepl.com automatically
# - no need to configure which tier you're on separately.
# Entirely optional: only used when run_pipeline.sh is invoked with
# --language <CODE> (e.g. --language FR). If left unset, translation is
# skipped and the rest of the pipeline is unaffected.
# Used by: translate_report.py
DEEPL_API_KEY=

